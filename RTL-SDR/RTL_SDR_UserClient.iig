//
//  RTL_SDR_UserClient.iig
//  RTL-SDR
//
//  IOUserClient bridging the RTL_SDR dext and the iPadOS host application
//  (the future Swift rtl_tcp server).
//
//  The app opens this user client with IOServiceOpen() and then:
//    * sends control commands with IOConnectCallScalarMethod()
//      (selectors: see kRTLSDRMethod* in RTLSDRShared.h),
//    * reads device info with IOConnectCallStructMethod(),
//    * maps the shared IQ ring buffer with IOConnectMapMemory64()
//      (memory type kRTLSDRMemoryTypeIQRing).
//

#ifndef RTL_SDR_UserClient_h
#define RTL_SDR_UserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>

class RTL_SDR_UserClient: public IOUserClient
{
public:
    //  Allocate / release the ivars block (DriverKit does not do it for you).
    virtual bool
    init() override;

    virtual void
    free() override;

    virtual kern_return_t
    Start(IOService * provider) override;

    virtual kern_return_t
    Stop(IOService * provider) override;

    virtual kern_return_t
    ExternalMethod(uint64_t selector,
                   IOUserClientMethodArguments * arguments,
                   const IOUserClientMethodDispatch * dispatch,
                   OSObject * target,
                   void * reference) override;

    virtual kern_return_t
    CopyClientMemoryForType(uint64_t type,
                            uint64_t * options,
                            IOMemoryDescriptor ** memory) override;
};

#endif /* RTL_SDR_UserClient_h */
